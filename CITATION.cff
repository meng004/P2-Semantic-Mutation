cff-version: 1.2.0
title: "A semantic mutation metric for metamorphic relation adequacy for scientific-computing kernels"
message: "If you use SMS in your research, please cite this preprint."
type: software
authors:
  - given-names: "Meng"
    family-names: "Li"
    email: "mlemon@usc.edu.cn"
    affiliation: "School of Computing, University of South China"
  - given-names: "Xiaohua"
    family-names: "Yang"
    affiliation: "School of Computing, University of South China"
  - given-names: "Jie"
    family-names: "Liu"
