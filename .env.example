# P2 LLM credentials — copy to .env and fill in your keys.
# .env is gitignored; never commit your real keys.

# Anthropic / Claude Opus 4.6 (mutant generator)
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# OpenAI-compatible proxy for GPT-5.4 (mutant reviewer R1).
# Substitute the BASE_URL with whichever OpenAI-compatible endpoint
# you have access to (the original campaign used a regional proxy;
# any compliant vendor works).
BLTCY_BASE_URL=<YOUR_BASE_URL>
BLTCY_API_KEY=<YOUR_API_KEY>

# DeepSeek V4 Pro (reviewer arbitrator R2 on UNCERTAIN verdicts)
DEEPSEEK_BASE_URL=<YOUR_BASE_URL>
DEEPSEEK_API_KEY=<YOUR_API_KEY>
